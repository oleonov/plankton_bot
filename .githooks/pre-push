#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running prettier --check on all tracked source files"
git ls-files \
  -- '*.cjs' '*.css' '*.html' '*.js' '*.json' '*.jsx' '*.md' '*.mjs' '*.ts' '*.tsx' '*.yaml' '*.yml' \
  | while IFS= read -r file; do
      if [ -n "$file" ] && [ -f "$file" ] && [ ! -L "$file" ]; then
        printf '%s\0' "$file"
      fi
    done \
  | xargs -0 pnpm exec prettier --check --ignore-unknown

echo "pre-push: running mandatory regression suites"
pnpm run test:prepush
