# Polymarket CLOB credentials
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# RUNTIME_MODE is optional — profile is read from control.db. Set only for legacy/override.
# Values: simulation | paper | live-lite
# RUNTIME_MODE=simulation

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# SQLite database path (relative to monorepo root, resolved to absolute at startup)
DB_PATH=./apps/runtime/data/plankton.db

# Dashboard authentication (optional — if unset, web login is disabled)
PLANKTON_AUTH_USERNAME=
PLANKTON_AUTH_PASSWORD=
PLANKTON_SESSION_SECRET=

# Set true when behind a reverse proxy (nginx/Caddy/Cloudflare)
TRUST_PROXY=false

# Market scanner interval in milliseconds (default 5m — how often to rescan gamma for new markets)
MARKET_SCAN_INTERVAL_MS=300000

# Algo decision sweep interval in milliseconds (default 12s — how often to re-evaluate signals per token)
STRATEGY_SCAN_INTERVAL_MS=12000

# Inventory sweep interval in milliseconds (default 5m)
INVENTORY_SWEEP_INTERVAL_MS=300000

# Wallet buffer reserved from available balance before sizing BUYs.
# EXECUTION_WALLET_BUFFER_PCT=0.03   # 3% of wallet balance
# EXECUTION_WALLET_BUFFER_MIN_USDC=0.25   # floor in USDC

