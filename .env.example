# Polymarket CLOB credentials
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Polymarket Builder / Relay auth
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# V2 CLOB builder attribution — bytes32 from Polymarket Builder Profile.
# Required for live-lite mode (preflight blocker LIVE_BUILDER_CODE_MISSING otherwise).
POLY_BUILDER_CODE=

# ─── Polygon RPC (live-lite only) ──────────────────────────────────────
# Alchemy Polygon API keys (keys only — the full URL is built in code).
# Comma-separated. Read-path RPC calls (collateral resolution, on-chain
# balance/allowance reads) round-robin across these keys with 429-failover;
# the settlement write-path uses them as an ordered viem fallback list.
ALCHEMY_POLYGON_KEYS=your_alchemy_key_1,your_alchemy_key_2,your_alchemy_key_3
# Non-Alchemy last-resort fallback (full URL). Held OUTSIDE the round-robin
# circle — tried only after every Alchemy key returns 429.
POLYGON_RPC_FALLBACK_URL=https://polygon.drpc.org
# Deprecated — use ALCHEMY_POLYGON_KEYS. Kept for backward-compat only:
# POLYGON_RPC_URL and POLYGON_RPC_URLS (comma-separated full URLs) still
# populate the primary rotation when no Alchemy keys are set.
# POLYGON_RPC_URL=
# POLYGON_RPC_URLS=

# RUNTIME_MODE is optional — profile is read from control.db. Only live-lite is supported
# as a runtime/operator profile. Historical paper/simulation rows may exist in DB, but
# they cannot be started.
# RUNTIME_MODE=live-lite

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# SQLite database path (relative to monorepo root, resolved to absolute at startup)
DB_PATH=./apps/runtime/data/ledger-live-lite.db

# Dashboard authentication (optional — if unset, web login is disabled)
KRABS_AUTH_USERNAME=
KRABS_AUTH_PASSWORD=
KRABS_SESSION_SECRET=

# Set true when behind a reverse proxy (nginx/Caddy/Cloudflare)
TRUST_PROXY=false

# Full Gamma discovery scan cadence in milliseconds (default 15m).
MARKET_SCAN_INTERVAL_MS=900000
# Minimum time between successful scan and a WS-hint-triggered rescan (default 15m).
MARKET_SCAN_HINT_MIN_INTERVAL_MS=900000
# Order/fill reconciliation cadence in milliseconds (default 15s).
RECONCILIATION_INTERVAL_MS=15000
# Reconciliation hardening (#36) — reliable open-orders/fills fetch + phantom-cancel gates.
# Retry count for a reliable reconciliation fetch before it is reported as failed (default 3).
RECONCILIATION_FETCH_RETRIES=3
# Per-retry backoff ladder in ms, comma-separated (default 100,500,2000).
RECONCILIATION_FETCH_BACKOFF_MS=100,500,2000
# Min local-open orders that make an empty exchange snapshot "suspicious" → skip pass (default 3, 0 disables).
RECONCILIATION_SUSPICIOUS_EMPTY_THRESHOLD=3
# Consecutive reliable misses before a missing local order is cancelled as phantom (default 3).
RECONCILIATION_CONSECUTIVE_MISS_THRESHOLD=3
# Fill-completion tolerance as a fraction of order size: within it → "filled" (default 0.005 = 0.5%).
RECONCILIATION_FILL_COMPLETION_TOLERANCE=0.005

# Optional Gamma API tag_id for server-side narrowing of the discovery sweep.
# When set, the scanner only sees events matching that tag (5–10× fewer markets crawled).
# When unset, the scanner broad-crawls all active events and filters locally via selection rules.
# GAMMA_TAG_ID=

# Algo decision sweep interval in milliseconds (default 12s — how often to re-evaluate signals per token)
STRATEGY_SCAN_INTERVAL_MS=12000
# Planner suppression telemetry rollup window in milliseconds (default 5m; 0 restores legacy per-event writes).
PLANNER_SUPPRESSION_ROLLUP_WINDOW_MS=300000

# Inventory sweep interval in milliseconds (default 5m)
INVENTORY_SWEEP_INTERVAL_MS=300000

# Wallet buffer reserved from available balance before sizing BUYs.
# EXECUTION_WALLET_BUFFER_PCT=0.03   # 3% of wallet balance
# EXECUTION_WALLET_BUFFER_MIN_USDC=0.25   # floor in USDC

# SELL size clamp policy (ADR-008). When true (default), SELL orders with intent
# size > availableSize are executed at availableSize (full-exit overshoot safety).
# When false, such orders are rejected with `reserved-token-limit`. Disable only
# if you suspect the clamp is masking a sizing bug upstream.
# ALLOW_SELL_SIZE_CLAMP=true

# ─── Market-data socket / stream tuning ────────────────────────────────
# All knobs below are defaulted; leave unset unless an incident log points at
# the corresponding subsystem. Env is read once at process start — container
# restart required to apply. See docs/runbooks/live_lite_preflight.md for
# tuning notes and expected ranges.

# Tiered pricing universe (Task 1): WS-subscribed universe cap + discovery tier.
# MARKET_DATA_MAX_TRACKED_TOKENS=1000
# MARKET_DATA_MAX_WS_SHARDS=2
# WS_WORKER_COUNT=20
# MARKET_DATA_DISCOVERY_POLL_INTERVAL_MS=300000
# MARKET_DATA_DISCOVERY_BATCH_SIZE=50

# CLOB axios HTTPS agent (Task 2): bounded connection pool to Polymarket.
# CLOB_AXIOS_MAX_SOCKETS=8
# CLOB_AXIOS_MAX_FREE_SOCKETS=2
# CLOB_AXIOS_IDLE_TIMEOUT_MS=30000

# Ingress backpressure (Task 3): per-shard bounded queue.
# MARKET_DATA_INGRESS_QUEUE_MAX=256
# MARKET_DATA_INGRESS_LAG_WARN_MS=2000
# MARKET_DATA_INGRESS_OVERFLOW_POLICY=drop-oldest   # drop-oldest | reconnect

# Per-shard + stream-level circuit breaker (Task 4). Stream-level breaker is
# AND-gated: fires only when (openShards/total ≥ PERCENT/100) AND
# (openShards ≥ FLOOR). On shardCount ≤ 2 the default floor (3) is unreachable
# by design — per-shard breakers handle the small-deployment case.
# MARKET_DATA_RECONNECT_BASE_MS=1000
# MARKET_DATA_RECONNECT_MAX_MS=30000
# MARKET_DATA_SHARD_BREAKER_RECONNECTS_PER_MIN=10
# MARKET_DATA_SHARD_BREAKER_OPEN_MS=120000
# MARKET_DATA_SHARD_BREAKER_OPEN_MAX_MS=600000
# MARKET_DATA_CIRCUIT_SHARD_OPEN_PERCENT=50
# MARKET_DATA_CIRCUIT_OPEN_SHARD_FLOOR=3
# MARKET_DATA_CIRCUIT_OPEN_MS=120000
# MARKET_DATA_STREAM_STABLE_MS=30000

# Capped rolling poll batch (Task 5): defensive cap on fallback/gap REST polls.
# MARKET_DATA_FALLBACK_BATCH_SIZE=500
# MARKET_DATA_FALLBACK_POLL_CONCURRENCY=50
# MARKET_DATA_FALLBACK_POLL_RATE_PER_SEC=5
# MARKET_DATA_STALE_TOKEN_AGE_MS=30000

# ADR-018 §D2 — Step 1 universe-filter funnel log cadence (post-normalization).
# Range: 5_000 – 3_600_000 ms. Default 60_000 ms (one log line per minute).
# UNIVERSE_FUNNEL_LOG_INTERVAL_MS=60000

# ADR-015 — DEAD_SIDE_GUARD_* and EXECUTION_PRICING_* env vars were moved into
# `profile_settings.execution_policy_json` (control.db). Edit via the web UI at
# /settings/execution or via PATCH /api/v1/profiles/:id/execution-policy.
# Runtime hot-reloads on version bump — no restart required.
