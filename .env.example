# Polymarket CLOB credentials
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Runtime mode: simulation | paper | live
RUNTIME_MODE=simulation

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# SQLite database path (relative to monorepo root, resolved to absolute at startup)
DB_PATH=./apps/runtime/data/plankton.db

# Family rules config path (relative to monorepo root)
FAMILY_RULES_PATH=./config/family_rules.yaml

# Dashboard authentication (optional — if unset, web login is disabled)
PLANKTON_AUTH_USERNAME=
PLANKTON_AUTH_PASSWORD=
PLANKTON_SESSION_SECRET=

# Set true when behind a reverse proxy (nginx/Caddy/Cloudflare)
TRUST_PROXY=false
