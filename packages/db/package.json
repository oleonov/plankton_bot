{
  "name": "@plankton/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && mkdir -p dist/migrations dist/schemas && cp src/migrations/*.sql dist/migrations/ && cp src/schemas/*.sql dist/schemas/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@plankton/config": "workspace:*",
    "@plankton/domain": "workspace:*",
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  }
}
