# ── Polymarket CLOB credentials ──────────────────────────────────────────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# ── Polymarket Builder / Relay auth ──────────────────────────────────────────
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# V2 CLOB builder attribution — bytes32 from Polymarket Builder Profile.
# Required for live-lite mode (preflight blocker LIVE_BUILDER_CODE_MISSING otherwise).
POLY_BUILDER_CODE=

# ── Runtime mode ─────────────────────────────────────────────────────────────
# RUNTIME_MODE is optional — profile is read from control.db. Set only for legacy/override.
# Values: simulation | paper | live-lite
# RUNTIME_MODE=paper

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database (path inside container, persisted via Docker volume) ─────────────
DB_PATH=./apps/runtime/data/krabs-paper.db

# ── API server ───────────────────────────────────────────────────────────────
KRABS_API_PORT=3100
KRABS_API_KEY=

# ── Dashboard authentication ─────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KRABS_AUTH_USERNAME=
KRABS_AUTH_PASSWORD=
KRABS_SESSION_SECRET=

# ── Live-lite envelope (only needed for RUNTIME_MODE=live-lite) ──────────────
# Deprecated: will move to profile_settings in DB
# POLY_PRIVATE_KEY=
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_RPC_FALLBACK_URL=https://polygon.drpc.org
# LIVE_LITE_CONFIRM=true
# LIVE_LITE_FAMILY_ALLOWLIST=
# LIVE_LITE_MAX_FAMILIES=
# LIVE_LITE_MAX_OPEN_VALUE_USDC=
# LIVE_LITE_MAX_ORDER_USDC=
# LIVE_LITE_MAX_ACTIVE_MARKETS=

# ── ADR-015 — execution policy moved to DB ──────────────────────────────────
# Dead-side guard + bounded-midpoint pricing are now stored in
# `profile_settings.execution_policy_json` (control.db) and hot-reload via
# `runtime_control_state.execution_policy_version`. Edit via the web UI at
# /settings/execution or PATCH /api/v1/profiles/:id/execution-policy.
