# ── Polymarket CLOB credentials ──────────────────────────────────────────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# ── Runtime mode ─────────────────────────────────────────────────────────────
# simulation | paper | live-lite
RUNTIME_MODE=paper

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database (path inside container, persisted via Docker volume) ─────────────
DB_PATH=./apps/runtime/data/plankton-paper.db

# ── Family rules (path inside container, mounted via Docker volume) ──────────
FAMILY_RULES_PATH=./config/family_rules.yaml

# ── API server ───────────────────────────────────────────────────────────────
PLANKTON_API_PORT=3100
PLANKTON_API_KEY=

# ── Dashboard authentication ─────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLANKTON_AUTH_USERNAME=
PLANKTON_AUTH_PASSWORD=
PLANKTON_SESSION_SECRET=

# ── Live-lite envelope (only needed for RUNTIME_MODE=live-lite) ──────────────
# POLY_PRIVATE_KEY=
# LIVE_LITE_CONFIRM=true
# LIVE_LITE_FAMILY_ALLOWLIST=
# LIVE_LITE_MAX_FAMILIES=
# LIVE_LITE_MAX_OPEN_VALUE_USDC=
# LIVE_LITE_MAX_ORDER_USDC=
# LIVE_LITE_MAX_ACTIVE_MARKETS=
